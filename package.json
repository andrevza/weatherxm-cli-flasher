{
  "name": "weatherxm-wg1200-cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": { "wg1200": "bin/wg1200.cjs" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "esptool-js": "0.7.0",
    "spark-md5": "3.0.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/spark-md5": "3.0.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "engines": { "node": ">=20" }
}
